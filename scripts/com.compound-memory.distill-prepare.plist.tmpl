<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent 模板：每天 09:00 跑一次蒸馏准备（占位符 __REPO__/__PYTHON__/__ROOT__ 经 sed 填充，见 README）。
     launchd 优于 cron：macOS 系统标准，睡眠错过的 StartCalendarInterval 唤醒后补跑。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.compound-memory.distill-prepare</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__REPO__/scripts/distill-prepare.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CM_PYTHON</key>
    <string>__PYTHON__</string>
    <key>COMPOUND_MEMORY_ROOT</key>
    <string>__ROOT__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__ROOT__/distill/prepare.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/distill/prepare.log</string>
</dict>
</plist>
